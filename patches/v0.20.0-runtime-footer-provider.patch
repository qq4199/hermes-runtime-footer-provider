+def _provider_name(model: Optional[str]) -> str:
+    """Extract provider/vendor prefix (``openai/gpt-5.4`` -> ``openai``)."""
+    if not model:
+        return ""
+    parts = model.rsplit("/", 1)
+    return parts[0] if len(parts) > 1 else ""
+
+
+def resolve_display_provider(
+    provider: Optional[str],
+    base_url: Optional[str],
+    config_providers: Optional[dict],
+) -> str:
+    """Map the normalized runtime provider name back to the configured key.
+
+    Hermes normalizes every user-defined endpoint to ``custom`` at runtime, so
+    the bare provider name is ambiguous when several custom endpoints exist.
+    Match the *runtime* base_url against ``providers.<key>.base_url`` in
+    config.yaml to recover the real key; stays correct across fallbacks.
+    """
+    burl = str(base_url or "").rstrip("/")
+    if burl and isinstance(config_providers, dict):
+        for key, val in config_providers.items():
+            if isinstance(val, dict) and str(val.get("base_url") or "").rstrip("/") == burl:
+                return str(key)
+    return str(provider or "")
+
